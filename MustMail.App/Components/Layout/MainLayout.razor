@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationState

<MudThemeProvider @ref="_mudThemeProvider" Theme="_mustMailTheme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="4" Dense>

            <a href="/">
                <MudImage Src="logo-transparent.png" Height="40"/>
            </a>

            <MudSpacer />

            <MudFabMenu Dense
                Label="@_name"
                AlignItems="AlignItems.End"
                Anchor="Origin.BottomLeft"
                Direction="Direction.Bottom"
                Ripple
                StartIcon="@Icons.Material.TwoTone.AccountCircle"
                DropShadow="false"
                OpenOnMouseHover="false"
                Size="Size.Medium">

                <AuthorizeView>
                    <Authorized Context="_">
                    
                        <MudFabMenuItem EndIcon="@Icons.Material.TwoTone.ManageAccounts"
                                        Color="Color.Tertiary" Style="color: rgb(33, 33, 33);"
                                        Href="/profile"
                                        Label="Profile" />

                    <AuthorizeView Policy="MustMailAdmin" Context="__">
                        
                        <MudFabMenuItem EndIcon="@Icons.Material.TwoTone.AdminPanelSettings"
                                        Color="Color.Tertiary" Style="color: rgb(33, 33, 33);"
                                        Href="/admin"
                                        Label="Admin" />

                    </AuthorizeView>
                        <form method="post" action="/authentication/logout">

                            <MudFabMenuItem EndIcon="@Icons.Material.TwoTone.Logout" 
                                Color="Color.Tertiary" Style="color: rgb(33, 33, 33);" 
                                Label="Sign out" ButtonType="ButtonType.Submit" />

                        </form>

                        
                    

                    </Authorized>

                    <NotAuthorized>

                        <form method="get" action="/authentication/login">

                            <AntiforgeryToken />

                            <MudFabMenuItem EndIcon="@Icons.Material.TwoTone.Login" 
                            Color="Color.Tertiary" Style="color: rgb(33, 33, 33);"
                            Label="Sign in" ButtonType="ButtonType.Submit" />

                        </form>

                    </NotAuthorized>

                </AuthorizeView>

        </MudFabMenu>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;

    // Default name
    private string _name = "Account";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthenticationState.GetAuthenticationStateAsync();

        // Set name
        _name = authState.User.Identity?.Name ?? "Account";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private readonly MudTheme _mustMailTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            AppbarBackground = "#BFBBAE",
            AppbarText = "rgba(66, 66, 66, 1)",
            Primary = "#e1dfd3",
            Secondary = "#4C7EFF"
        },
        PaletteLight = new PaletteLight
        {
            AppbarBackground = "#e1dfd3",
            AppbarText = "rgba(66, 66, 66, 1)",
            Primary = "#C9A84A",
            Secondary = "#4C7EFF"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Quicksand", "sans-serif"],
                FontWeight = "400"
            },
            H1 = new H1Typography
            {
                FontWeight = "600",
                FontSize = "4em"
            },
            Body1 = new Body1Typography
            {
                FontSize = "0.8em"
            },
            Body2 = new Body2Typography
            {
                FontSize = "0.9em"
            },
            Subtitle2 = new Subtitle2Typography
            {
                FontSize = ".9rem",
                FontWeight = "300"
            }
        }
    };

}