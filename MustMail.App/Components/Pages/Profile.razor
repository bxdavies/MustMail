@page "/profile"
@inherits ProfileBase
@attribute [Authorize]
<PageTitle> MustMail - Profile</PageTitle>

<MudText Typo="Typo.h4" Class="mt-1"> Profile </MudText>

<MudText Typo="Typo.subtitle2">
	This section allows you to change how values are displayed.
</MudText>

<EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
	<DataAnnotationsValidator/>
	<MudGrid Justify="Justify.Center" Class="mt-1">
		<MudItem xs="12" sm="6">
			<MudPaper Class="pa-4" Elevation="1" MaxWidth="900px">

				<MudCardContent>
					<MudAutocomplete T="TimeZoneInfo" Label="Time zone" @bind-Value="Model.TimeZone"
					                 For="@(() => Model.TimeZone)" SearchFunc="@TimeZoneSearch" MaxItems="20"
					                 ToStringFunc="@(t => t?.DisplayName)"/>
					<MudTextField T="string" Label="Date format" @bind-Value="Model.DateFormat"
					              For="@(() => Model.DateFormat)"/>
					<MudText Class="mud-input-helper-text">
						A list of the format specifiers can be found in a table
						<MudLink
							Href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings"
							Color="Color.Secondary"> here
						</MudLink>
						.
					</MudText>

					<MudTextField T="string" Label="Time format" @bind-Value="Model.TimeFormat"
					              For="@(() => Model.TimeFormat)"/>
					<MudText Class="mud-input-helper-text">
						A list of the format specifiers can be found in a table
						<MudLink
							Href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings"
							Color="Color.Secondary"> here
						</MudLink>
						.
					</MudText>
				</MudCardContent>
				<MudCardActions>
					<MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
					           Class="ml-auto">
						Save Profile
					</MudButton>
				</MudCardActions>
			</MudPaper>
		</MudItem>
	</MudGrid>
</EditForm>